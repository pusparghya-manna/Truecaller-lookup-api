# Required: generate a long random value and set it in Railway Variables (or any host env).
TRUECALLER_API_KEY=replace-with-a-long-random-value

# Required for authenticated Truecaller lookups.
# Paste a Cookie-Editor / Playwright JSON export here as a secret.
# Never commit the real value.
TRUECALLER_COOKIES_JSON=

API_ANYTHING_HOME=/tmp/api-anything
API_ANYTHING_CLI=/opt/api-anything/dist/cli.js
API_ANYTHING_CWD=/opt/api-anything
