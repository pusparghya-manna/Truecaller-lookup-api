# Required: generate a long random value and set it privately in Render.
TRUECALLER_API_KEY=replace-with-a-long-random-value

# Required for authenticated Truecaller lookups.
# Paste a Cookie-Editor/Playwright JSON export here as a Render secret.
# Never commit the real value or put it in this zip.
TRUECALLER_COOKIES_JSON=

API_ANYTHING_HOME=/tmp/api-anything
